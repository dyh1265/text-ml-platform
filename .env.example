# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_IMDB_TOPIC=imdb-reviews
KAFKA_INFERENCE_TOPIC=imdb-inference
KAFKA_IMDB_DLQ_TOPIC=imdb-reviews-dlq

# Object storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_REGION_NAME=us-east-1
S3_DATA_BUCKET=text-ml-data

# Layer prefixes
BRONZE_PREFIX=bronze/
SILVER_PREFIX=silver/
GOLD_PREFIX=gold/
FEATURES_PREFIX=features/

# Iceberg catalog
ICEBERG_CATALOG_DB=iceberg_catalog/catalog.db

# IMDb dataset
IMDB_DEFAULT_SPLIT=test
# IMDB_MAX_RECORDS=500

# Demo / UI
PREDICT_API_URL=http://localhost:8002/predict
GOLD_ICEBERG_IDENTIFIER=imdb.gold_train
PCA_MAX_POINTS=1500
OLLAMA_API_BASE=http://localhost:11434/v1
DEFAULT_MODEL_PATH=models/sentiment_logreg.joblib
ASYNC_PREDICTION_TIMEOUT_S=180
